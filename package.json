{
  "name": "roomcrosscheck",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm --workspace frontend run dev --",
    "build": "npm --workspace frontend run build",
    "preview": "npm --workspace frontend run preview --",
    "test": "npm --workspace frontend test",
    "test:runtime": "python tests/java-runtime.test.py && python tests/evaluation-readiness.test.py",
    "test:browser": "python scripts/verify-sfr003-browser.py",
    "test:browser:replay": "python scripts/verify-sfr003-browser.py --replay-image-001",
    "evaluation:check": "python scripts/check-sfr003-evaluation.py"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}

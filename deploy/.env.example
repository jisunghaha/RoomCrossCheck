# 운영 서버 전용 환경변수. 서버에서 deploy/.env로 복사해 채우고 Git에 올리지 않는다.
# cp deploy/.env.example deploy/.env && chmod 600 deploy/.env

# 비워 두면 서버 IP의 HTTP(:80)로만 제공한다. 도메인을 연결하면 예: room.example.com
SITE_ADDRESS=

# 각각 다른 긴 임의 값으로 설정한다. 예: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ROOM_DB_PASSWORD=
ROOM_DB_ROOT_PASSWORD=

# 1GB 메모리 VM이면 기본값을 유지한다.
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=60

GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

BUILDING_REGISTER_API_KEY=

# 구글 OAuth 리디렉션 URI는 HTTPS 도메인이 생긴 뒤 등록한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
